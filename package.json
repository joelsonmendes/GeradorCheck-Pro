{
  "name": "geradorcheck-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:functions": "npm --workspace functions run build",
    "build:all": "npm run build && npm run build:functions",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"functions/src/**/*.ts\" \"*.{json,md}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"functions/src/**/*.ts\" \"*.{json,md}\" \".github/workflows/*.yml\"",
    "preview": "vite preview",
    "emulators": "firebase emulators:start",
    "deploy": "npm run build:all && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "grant-admin": "npm --workspace functions run grant-admin --"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "firebase-tools": "^15.26.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
